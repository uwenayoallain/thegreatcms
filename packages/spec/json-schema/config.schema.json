{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GreatCMS config",
  "description": "Repository layout and publishing settings for GreatCMS (.cms/config.yaml).",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Version of the standard this file is written for.",
      "type": "integer",
      "minimum": 1
    },
    "content": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "regions": {
          "description": "Directory for structured region JSON.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\\\u0000-\\u001f]+$",
          "default": "content/cms"
        },
        "media": {
          "description": "Directory uploads are committed into.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\\\u0000-\\u001f]+$",
          "default": "public/media"
        }
      }
    },
    "mediaUrlPrefix": {
      "description": "URL prefix the site serves `content.media` from.",
      "type": "string",
      "default": "/media"
    },
    "publish": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "commitMessage": {
          "type": "string",
          "default": "content: update {summary}"
        },
        "branch": {
          "description": "No longer read; still accepted.",
          "type": "string"
        },
        "draftBranchPrefix": {
          "description": "No longer read; still accepted.",
          "type": "string"
        },
        "dispatchEvent": {
          "description": "No longer read; still accepted.",
          "type": ["string", "null"]
        }
      }
    },
    "preview": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "paths": {
          "description": "Where an entry is seen on the site, per collection: a path with `{slug}`, or a map of slug to path with `\"*\"` as the fallback.",
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "urlTemplate": {
          "description": "No longer read; still accepted.",
          "type": ["string", "null"]
        }
      }
    }
  }
}
