{
  "name": "@greatcms/spec",
  "version": "0.1.0",
  "description": "The GreatCMS content standard: schema format, content layout, and validation. Framework and language agnostic.",
  "license": "MIT",
  "files": [
    "dist",
    "json-schema"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json-schema": "./json-schema/schema.schema.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/gen-json-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "zod-to-json-schema": "^3.25.2"
  }
}
