{
  "name": "@greatcms/spec",
  "version": "0.1.2",
  "description": "The GreatCMS content standard in TypeScript: schema, config, content parsing, validation and resolution, with no I/O.",
  "keywords": [
    "astro",
    "cms",
    "content",
    "git",
    "headless",
    "json-schema",
    "schema"
  ],
  "homepage": "https://github.com/uwenayoallain/thegreatcms/tree/main/packages/spec#readme",
  "bugs": {
    "url": "https://github.com/uwenayoallain/thegreatcms/issues"
  },
  "license": "MIT",
  "author": "UWENAYO Alain Pacifique",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwenayoallain/thegreatcms.git",
    "directory": "packages/spec"
  },
  "files": [
    "dist",
    "json-schema",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json-schema": "./json-schema/schema.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
