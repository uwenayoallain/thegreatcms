{
  "name": "@greatcms/reader",
  "version": "0.1.2",
  "description": "Build-time reader for GreatCMS content: synchronous filesystem reads, schema defaults, and live-preview integrations for Astro, Next.js, Nuxt, SvelteKit and Vite.",
  "keywords": [
    "astro",
    "cms",
    "content",
    "git",
    "nextjs",
    "nuxt",
    "react",
    "static-site",
    "sveltekit",
    "vite"
  ],
  "homepage": "https://github.com/uwenayoallain/thegreatcms/tree/main/packages/reader#readme",
  "bugs": {
    "url": "https://github.com/uwenayoallain/thegreatcms/issues"
  },
  "license": "MIT",
  "author": "UWENAYO Alain Pacifique",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwenayoallain/thegreatcms.git",
    "directory": "packages/reader"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "default": "./dist/nuxt.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "default": "./dist/sveltekit.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@greatcms/spec": "workspace:*"
  },
  "devDependencies": {
    "@greatcms/conformance": "workspace:*",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
