{
  "name": "@greatcms/reader",
  "version": "0.1.1",
  "description": "Build-time reader for GreatCMS content: synchronous filesystem reads, schema defaults, and a Vite plugin and Astro integration for live preview.",
  "keywords": [
    "astro",
    "cms",
    "content",
    "git",
    "static-site",
    "vite"
  ],
  "homepage": "https://greatcms.dev",
  "bugs": {
    "url": "https://github.com/uwenayoallain/thegreatcms/issues"
  },
  "license": "MIT",
  "author": "UWENAYO Alain Pacifique",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwenayoallain/thegreatcms.git",
    "directory": "packages/reader"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@greatcms/spec": "workspace:*"
  },
  "devDependencies": {
    "@greatcms/conformance": "workspace:*",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
