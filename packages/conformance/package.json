{
  "name": "@greatcms/conformance",
  "version": "0.1.5",
  "description": "Fixtures and a verifier that define what reading the GreatCMS standard correctly means, in any language.",
  "keywords": [
    "cms",
    "conformance",
    "fixtures",
    "testing"
  ],
  "homepage": "https://github.com/uwenayoallain/thegreatcms/tree/main/packages/conformance#readme",
  "bugs": {
    "url": "https://github.com/uwenayoallain/thegreatcms/issues"
  },
  "license": "MIT",
  "author": "UWENAYO Alain Pacifique",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwenayoallain/thegreatcms.git",
    "directory": "packages/conformance"
  },
  "bin": {
    "greatcms-conformance": "./bin/greatcms-conformance.mjs"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "fixtures",
    "expected",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@greatcms/spec": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
