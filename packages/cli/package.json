{
  "name": "@greatcms/cli",
  "version": "0.1.0",
  "description": "Preview unpublished GreatCMS drafts against your own dev server, and check a repository's setup.",
  "license": "MIT",
  "bin": {
    "greatcms": "./bin/greatcms.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@greatcms/spec": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
