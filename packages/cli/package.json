{
  "name": "@greatcms/cli",
  "version": "0.1.2",
  "description": "greatcms: scaffold, extend, type and check a GreatCMS site from the terminal.",
  "keywords": [
    "cli",
    "cms",
    "content",
    "git",
    "schema",
    "typescript"
  ],
  "homepage": "https://github.com/uwenayoallain/thegreatcms/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/uwenayoallain/thegreatcms/issues"
  },
  "license": "MIT",
  "author": "UWENAYO Alain Pacifique",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwenayoallain/thegreatcms.git",
    "directory": "packages/cli"
  },
  "bin": {
    "greatcms": "./bin/greatcms.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./starter": {
      "types": "./dist/starter.d.ts",
      "default": "./dist/starter.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "@greatcms/spec": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@greatcms/reader": "workspace:*",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
