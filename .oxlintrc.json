{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["**/dist/**", "**/.astro/**", "**/json-schema/**", "**/node_modules/**"],
  "rules": {
    "no-console": "off",
    "typescript/no-explicit-any": "warn",
    "unicorn/prefer-node-protocol": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_meta", "_type", "_ast"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
