# Copy to .env. Everything the server needs; nothing here is committed.

# The one domain everything hangs off. Point A records for DOMAIN, www, studio and preview at
# this server, and Caddy gets certificates for all four. For a local try-out use
# compose.local.yaml and set DOMAIN=localhost.
DOMAIN=kivu-seedworks.example

# What editors type to sign in. The same sign-in opens the preview; there is no second password.
STUDIO_PASSWORD=choose-a-long-passphrase-editors-will-type
# Signs the session cookies, so signing in survives a restart:  openssl rand -hex 32
STUDIO_SECRET=

# Where the site's working copy lives on the host. Clone it there once:
#   git clone https://github.com/uwenayoallain/thegreatcms.git /srv/sites/kivu-seedworks
SITES_DIR=/srv/sites

# Commits made from the studio carry this name.
GIT_NAME=Studio
GIT_EMAIL=studio@example.com

# Optional: also push each publish to GitHub as a backup. Needs ./ssh/id_ed25519 (a deploy key
# with write access) and the repository's origin set in the sites volume.
PUSH_AFTER_PUBLISH=false

# Optional: email every contact-form submission.
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=
