# Hosts come from compose: one DOMAIN gives the site, www, studio and preview addresses.
# compose.local.yaml runs the same thing on localhost ports without TLS.

{$SCHEME}://{$SITE_HOST} {
	redir {$SCHEME}://{$WWW_HOST}{uri} permanent
}

{$SCHEME}://{$WWW_HOST} {
	root * /srv/www/current
	file_server
	encode zstd gzip
	try_files {path} {path}.html {path}/index.html
	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$SCHEME}://{$STUDIO_HOST} {
	reverse_proxy studio:8787
}

# The dev server is not built for strangers. The studio vouches for each request: a browser
# signed in to the studio gets through, anyone else is sent to the studio's sign-in and back.
{$SCHEME}://{$PREVIEW_HOST} {
	forward_auth studio:8787 {
		uri /auth/check
	}
	reverse_proxy preview:4321
}
