---
import type { ProductsEntry } from '../cms';
import ManagedImage from './ManagedImage.astro';

interface Props {
  product: ProductsEntry;
  compact?: boolean;
}

const { product, compact = false } = Astro.props;
const { data } = product;
const Heading = compact ? 'h3' : 'h2';
---

<article class:list={['product-card', { compact }]}>
  <ManagedImage image={data.image} class="product-image" />
  <div class="product-card__topline">
    <p class="product-card__category">{data.category ?? 'Field supply'}</p>
    {data.featured && <span class="availability">In focus</span>}
  </div>
  <Heading><a class="product-card__name" href={`/products/${product.slug}/`}>{data.name}</a></Heading>
  <p>{data.description}</p>
  {
    data.enquiry?.href && (
      <a href={data.enquiry.href}>{data.enquiry.label ?? 'Ask about this product'} <span aria-hidden="true">→</span></a>
    )
  }
</article>
