---
import type { HomeSectionsRegion, PagesEntry, ProductsEntry } from '../cms';
import ProductCard from './ProductCard.astro';
import ManagedImage from './ManagedImage.astro';

interface Props {
  section:
    | HomeSectionsRegion['blocks'][number]
    | NonNullable<PagesEntry['data']['sections']>[number];
  products: ProductsEntry[];
  index: number;
}

const { section, products, index } = Astro.props;
const headingId = `section-${index}`;
const mark: Record<string, string> = { soil: '≈', route: '↗', notes: '≡' };
---

{
  section._type === 'feature-grid' && (
    <section class="section feature-section" aria-labelledby={headingId}>
      <div class="section-intro">
        <p class="kicker">How we work</p>
        <h2 id={headingId}>{section.heading}</h2>
        {section.introduction && <p>{section.introduction}</p>}
      </div>
      <div class="feature-grid">
        {(section.items ?? []).map((item) => (
          <article class="feature-card">
            <span class="feature-mark" aria-hidden="true">{mark[item.icon ?? ''] ?? '•'}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>
  )
}

{
  section._type === 'process' && (
    <section class="section process-section" aria-labelledby={headingId}>
      <div class="section-intro process-intro">
        {section.eyebrow && <p class="kicker">{section.eyebrow}</p>}
        <h2 id={headingId}>{section.heading}</h2>
        {section.introduction && <p>{section.introduction}</p>}
      </div>
      <ol class="process-track">
        {(section.steps ?? []).map((step, stepIndex) => (
          <li>
            <span class="process-number" aria-hidden="true">{String(stepIndex + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </section>
  )
}

{
  section._type === 'stats' && (
    <section class="stats-section" aria-label={section.heading ?? 'At a glance'}>
      {section.heading && <p class="stats-heading">{section.heading}</p>}
      <dl>
        {(section.items ?? []).map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd><strong>{item.value}</strong>{item.detail && <span>{item.detail}</span>}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

{
  section._type === 'story' && (
    <section class:list={['section', 'story-section', `image-${section.imageSide}`]} aria-labelledby={headingId}>
      <div class="story-copy">
        {section.eyebrow && <p class="kicker">{section.eyebrow}</p>}
        <h2 id={headingId}>{section.heading}</h2>
        <div class="richtext" set:html={section.body.html} />
        {section.link?.href && <a class="text-link" href={section.link.href}>{section.link.label ?? 'Read more'} <span aria-hidden="true">→</span></a>}
      </div>
      {section.image?.src ? <ManagedImage image={section.image} class="story-image" /> : <div class="field-map" aria-hidden="true">
        <span>season / soil / crop / area</span>
      </div>}
    </section>
  )
}

{
  section._type === 'products' && (
    <section class="section products-section" aria-labelledby={headingId}>
      <div class="section-intro row">
        <div>
          <p class="kicker">Current range</p>
          <h2 id={headingId}>{section.heading}</h2>
          {section.introduction && <p>{section.introduction}</p>}
        </div>
        {section.link?.href && <a class="text-link" href={section.link.href}>{section.link.label ?? 'View products'} <span aria-hidden="true">→</span></a>}
      </div>
      <div class="product-grid">
        {products.filter((product) => product.data.featured).map((product) => <ProductCard product={product} compact />)}
      </div>
    </section>
  )
}

{
  section._type === 'faq-list' && (
    <section class="section faq-section" aria-labelledby={headingId}>
      <div class="section-intro">
        <p class="kicker">Useful answers</p>
        <h2 id={headingId}>{section.heading}</h2>
      </div>
      <div class="faq-list">
        {(section.items ?? []).map((item) => (
          <details>
            <summary>{item.question}</summary>
            <div class="richtext" set:html={item.answer.html} />
          </details>
        ))}
      </div>
    </section>
  )
}

{
  section._type === 'cta' && (
    <section class="cta-section" aria-labelledby={headingId}>
      <div>
        <p class="kicker">Next field note</p>
        <h2 id={headingId}>{section.heading}</h2>
        {section.body && <p>{section.body}</p>}
      </div>
      <div class="button-row">
        <a class="button light" href={section.primary.href}>{section.primary.label ?? 'Get started'}</a>
        {section.secondary?.href && <a class="button quiet" href={section.secondary.href}>{section.secondary.label ?? 'Learn more'}</a>}
      </div>
    </section>
  )
}
