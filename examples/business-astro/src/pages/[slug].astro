---
import type { PagesEntry } from '../cms';
import SectionRenderer from '../components/SectionRenderer.astro';
import ManagedImage from '../components/ManagedImage.astro';
import Base from '../layouts/Base.astro';
import { cms } from '../lib/cms';

export function getStaticPaths() {
  return cms.collection('pages').map((page) => ({ params: { slug: page.slug } }));
}

// Looked up per render, not taken from props: the dev server caches getStaticPaths,
// which would hide the studio's unsaved edit from the live preview.
const page: PagesEntry | undefined = cms.collection('pages').find((entry) => entry.slug === Astro.params.slug);
if (!page) return Astro.redirect('/404');
const { data } = page;
const products = cms.collection('products');
---

<Base title={data.seoTitle ?? data.title} description={data.seoDescription ?? data.summary}>
  <header class:list={['page-hero', { legal: data.kind === 'legal' }] }>
    {data.eyebrow && <p class="kicker">{data.eyebrow}</p>}
    <h1>{data.heading}</h1>
    {data.summary && <p>{data.summary}</p>}
    {(data.primary?.href || data.secondary?.href) && <div class="button-row">
      {data.primary?.href && <a class="button" href={data.primary.href}>{data.primary.label ?? 'Learn more'}</a>}
      {data.secondary?.href && <a class="button page-outline" href={data.secondary.href}>{data.secondary.label ?? 'Contact us'}</a>}
    </div>}
    <ManagedImage image={data.image} class="page-image" eager />
  </header>

  {data.body && <article class="managed-prose richtext" set:html={data.body.html} />}
  {(data.sections ?? []).map((section, index) => (
    <SectionRenderer section={section} products={products} index={index} />
  ))}
</Base>
