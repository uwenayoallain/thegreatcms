---
import ProductCard from '../components/ProductCard.astro';
import Base from '../layouts/Base.astro';
import { cms } from '../lib/cms';

const products = cms.collection('products');
---

<Base title="Products" description="Seed, soil inputs, and field support grouped by the job they do.">
  <header class="page-hero">
    <p class="kicker">Current range</p>
    <h1>Fewer choices. Clearer jobs.</h1>
    <p>Every item starts as one JSON entry. Add a product in the studio and this list grows without changing the page.</p>
  </header>
  <div class="product-grid all-products">
    {products.map((product) => <ProductCard product={product} />)}
  </div>
</Base>
