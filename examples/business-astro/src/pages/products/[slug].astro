---
import type { ProductsEntry } from '../../cms';
import ManagedImage from '../../components/ManagedImage.astro';
import Base from '../../layouts/Base.astro';
import { cms } from '../../lib/cms';

export function getStaticPaths() {
  return cms.collection('products').map((product) => ({ params: { slug: product.slug } }));
}

// Looked up per render, not taken from props: the dev server caches getStaticPaths,
// which would hide the studio's unsaved edit from the live preview.
const product: ProductsEntry | undefined = cms.collection('products').find((entry) => entry.slug === Astro.params.slug);
if (!product) return Astro.redirect('/404');
const { data } = product;
---

<Base title={data.name} description={data.description}>
  <article class="product-detail">
    <header>
      <p class="kicker">{data.category ?? 'Field supply'}</p>
      <h1>{data.name}</h1>
      <p class="product-detail__lede">{data.description}</p>
      {data.enquiry?.href && <a class="button" href={data.enquiry.href}>{data.enquiry.label ?? 'Ask about this product'}</a>}
      <ManagedImage image={data.image} class="product-image detail-image" eager />
    </header>
    <div class="product-spec">
      {data.packaging && <div class="product-packaging"><p class="kicker">Supplied as</p><p>{data.packaging}</p></div>}
      {data.details && data.details.length > 0 && <section aria-labelledby="details-heading"><h2 id="details-heading">Before you use it</h2><ul>{data.details.map((detail) => <li>{detail}</li>)}</ul></section>}
      {data.benefits && data.benefits.length > 0 && <section aria-labelledby="benefits-heading"><h2 id="benefits-heading">Why it may fit</h2><ul>{data.benefits.map((benefit) => <li>{benefit}</li>)}</ul></section>}
    </div>
  </article>
</Base>
