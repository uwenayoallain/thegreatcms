---
import Base from '../layouts/Base.astro';
import { cms } from '../lib/cms';

const contact = cms.region('site.contact');
---

<Base title="Page not found" description="There is no page at this address.">
  <header class="page-hero">
    <p class="kicker">Page not found</p>
    <h1>That path leads nowhere.</h1>
    <p>The page may have moved, or the address may have a typo. Everything we offer is one step from here.</p>
    <div class="button-row">
      <a class="button" href="/products/">See the products</a>
      <a class="button page-outline" href="/contact/">Contact us</a>
    </div>
    <p><a href="/">Back to the home page</a> · <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>Call {contact.phone}</a></p>
  </header>
</Base>
