---
import Feature from '../components/Feature.astro';
import Quote from '../components/Quote.astro';
import Base from '../layouts/Base.astro';
import { cms } from '../lib/cms';

const hero = cms.region('home.hero');
const features = cms.region('home.features').blocks;

// Where form submissions go.
const studio = import.meta.env.PUBLIC_CMS_URL ?? '';
const siteId = import.meta.env.PUBLIC_CMS_SITE_ID ?? 'example';

const steps = [
  { title: 'Write', text: 'Edit the page you are looking at, with the real design beside the form.' },
  { title: 'Publish', text: 'One click saves it as a commit, with your name on it and a history behind it.' },
  { title: 'Go live', text: 'The site rebuilds the way it always has. Nothing new sits between it and its visitors.' },
];
---

<Base
  title={hero.heading}
  description={hero.subtitle}
  schema={{ '@type': 'WebSite', name: 'Example', url: Astro.site?.href }}
>
  <section class="hero">
    <div class="hero-copy">
      <h1>{hero.heading}</h1>
      {hero.subtitle && <p class="lede">{hero.subtitle}</p>}
      <p class="hero-actions">
        {hero.cta?.href && <a class="button" href={hero.cta.href}>{hero.cta.label ?? 'Learn more'}</a>}
        <a class="text-link" href="/about/">How we work <span aria-hidden="true">→</span></a>
      </p>
    </div>

    <!-- A picture of the promise, drawn in HTML: a client's page with one line being changed. -->
    <div class="hero-art" aria-hidden="true">
      <div class="window">
        <div class="window-bar"><i></i><i></i><i></i><span>cafe-lumiere.example</span></div>
        <div class="window-body">
          <p class="mock-kicker">Café Lumière</p>
          <p class="mock-title">Opening hours</p>
          <dl class="mock-hours">
            <div><dt>Monday to Friday</dt><dd>7:00 – 18:00</dd></div>
            <div class="is-editing"><dt>Saturday</dt><dd>8:00 – <mark>16:00</mark></dd></div>
            <div><dt>Sunday</dt><dd>Closed</dd></div>
          </dl>
        </div>
      </div>
      <p class="mock-status"><b></b>Published by Marie, just now</p>
    </div>
  </section>

  <section aria-labelledby="how">
    <h2 id="how">From a sentence to a live page</h2>
    <ol class="steps" role="list">
      {
        steps.map((step, index) => (
          <li>
            <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    features.length > 0 && (
    <section aria-labelledby="why">
      <h2 id="why">Why it works this way</h2>
      <ul class="grid" role="list">
        {
          features.map((block) =>
            block._type === 'feature' ? <Feature block={block} /> : <Quote block={block} />,
          )
        }
      </ul>
    </section>
    )
  }

  <section class="contact-section" aria-labelledby="contact">
    <div class="contact-intro">
      <p class="eyebrow">Contact</p>
      <h2 id="contact">Tell us about your site</h2>
      <p>Questions, ideas, or a site you would like to move over. Every message is read by a person.</p>

      <dl class="contact-details">
        <div>
          <dt>Email</dt>
          <dd><a href="mailto:hello@example.com">hello@example.com</a></dd>
        </div>
        <div>
          <dt>Replies</dt>
          <dd>Usually within a day</dd>
        </div>
      </dl>

      <div class="contact-person">
        <span class="avatar" aria-hidden="true">AU</span>
        <p><strong>Aline Uwimana</strong> reads every message, and builds the sites herself.</p>
      </div>
    </div>

    <form class="contact" method="POST" action={`${studio}/f/${siteId}/contact`}>
      <div class="field">
        <label for="name">Your name <span class="required" aria-hidden="true">Required</span></label>
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder="First and last name"
          aria-describedby="name-error"
          required
        />
        <span class="error" id="name-error">Tell us what to call you.</span>
      </div>

      <div class="field">
        <label for="email">Email <span class="required" aria-hidden="true">Required</span></label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@example.com"
          aria-describedby="email-hint email-error"
          required
        />
        <span class="hint" id="email-hint">So we can reply. Never shared.</span>
        <span class="error" id="email-error">Enter an address like name@example.com.</span>
      </div>

      <div class="field">
        <label for="message">Message <span class="required" aria-hidden="true">Required</span></label>
        <textarea
          id="message"
          name="message"
          rows="6"
          placeholder="A line or two about your site, or what you would like it to do."
          aria-describedby="message-error"
          required
        ></textarea>
        <span class="error" id="message-error">Write a few words before sending.</span>
      </div>

      <!-- Where to land after posting, and when the form was rendered: a submission filled in
           under a second is scored as a bot, so nobody is shown a CAPTCHA. -->
      <input type="hidden" name="_redirect" value="/thanks/" />
      <input type="hidden" name="_t" value={String(Date.now())} />

      <!-- Spam trap: real people never fill this in. -->
      <div class="trap" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form-actions">
        <button type="submit">Send message</button>
        <p>No account, no newsletter. Just a reply.</p>
      </div>
    </form>
  </section>
</Base>
