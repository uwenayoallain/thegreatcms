---
import Feature from '../components/Feature.astro';
import Quote from '../components/Quote.astro';
import Base from '../layouts/Base.astro';
import { cms } from '../lib/cms';

const hero = cms.region('home.hero');
const features = cms.region('home.features').blocks;

// Where form submissions go.
const studio = import.meta.env.PUBLIC_CMS_URL ?? '';
const siteId = import.meta.env.PUBLIC_CMS_SITE_ID ?? 'example';

const steps = [
  { title: 'Write', text: 'Edit the page you are looking at, with the real design beside the form.' },
  { title: 'Publish', text: 'One click saves it as a commit, with your name on it and a history behind it.' },
  { title: 'Go live', text: 'The site rebuilds the way it always has. Nothing new sits between it and its visitors.' },
];
---

<Base title={hero.heading} description={hero.subtitle}>
  <section class="hero">
    <h1>{hero.heading}</h1>
    {hero.subtitle && <p class="lede">{hero.subtitle}</p>}
    {hero.cta?.href && <a class="button" href={hero.cta.href}>{hero.cta.label ?? 'Learn more'}</a>}
  </section>

  <section aria-labelledby="how">
    <h2 id="how">From a sentence to a live page</h2>
    <ol class="steps" role="list">
      {
        steps.map((step, index) => (
          <li>
            <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="why">
    <h2 id="why">Why it works this way</h2>
    <ul class="grid" role="list">
      {
        features.map((block) =>
          block._type === 'feature' ? <Feature block={block} /> : <Quote block={block} />,
        )
      }
    </ul>
  </section>

  <section class="contact-section" aria-labelledby="contact">
    <div class="contact-intro">
      <h2 id="contact">Send a message</h2>
      <p>Questions, ideas, or a site you would like to move over. Every message is read by a person.</p>
    </div>

    <form class="contact" method="POST" action={`${studio}/f/${siteId}/contact`}>
      <div>
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>

      <div>
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          aria-describedby="email-hint"
          required
        />
        <span class="hint" id="email-hint">So we can reply. Never shared.</span>
      </div>

      <div>
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>

      <!-- Where to land after posting, and when the form was rendered: a submission filled in
           under a second is scored as a bot, so nobody is shown a CAPTCHA. -->
      <input type="hidden" name="_redirect" value="/thanks/" />
      <input type="hidden" name="_t" value={String(Date.now())} />

      <!-- Spam trap: real people never fill this in. -->
      <div class="trap" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit">Send message</button>
    </form>
  </section>
</Base>
