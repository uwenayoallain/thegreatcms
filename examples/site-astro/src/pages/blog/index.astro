---
import Base from '../../layouts/Base.astro';
import { cms } from '../../lib/cms';

const posts = cms
  .collection('blog')
  .toSorted((a, b) => b.data.date.localeCompare(a.data.date));
---

<Base title="Blog" description="Notes on building websites that last.">
  <section class="page-intro">
    <h1>Blog</h1>
    <p class="lede">Notes on building websites that last, and on keeping them easy to change.</p>

    {posts.length === 0 && <p>Nothing has been published yet.</p>}
    <ul class="entry-list" role="list" hidden={posts.length === 0}>
      {
        posts.map((post) => (
          <li>
            <h2>
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            </h2>
            <time datetime={post.data.date}>
              {new Date(post.data.date).toLocaleDateString('en', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            {post.data.description && <p>{post.data.description}</p>}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
