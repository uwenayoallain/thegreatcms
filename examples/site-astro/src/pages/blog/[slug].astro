---
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import { cms } from '../../lib/cms';

export function getStaticPaths() {
  return cms.collection('blog').map((entry) => ({ params: { slug: entry.slug } }));
}

// Looked up per render, not taken from props: the dev server caches getStaticPaths,
// which would hide the studio's unsaved edit from the live preview.
const entry = cms.collection('blog').find((candidate) => candidate.slug === Astro.params.slug);
if (!entry) return Astro.redirect('/404');
// A code block scrolls sideways on a narrow screen, so the keyboard has to be able to reach it.
const html = (marked.parse(entry.body) as string).replaceAll('<pre>', '<pre tabindex="0">');
const date = new Date(entry.data.date);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  schema={{
    '@type': 'BlogPosting',
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: date.toISOString().slice(0, 10),
    publisher: { '@type': 'Organization', name: 'Example' },
  }}
>
  <article class="prose">
    <a class="back" href="/blog/">← All posts</a>
    <h1>{entry.data.title}</h1>
    {entry.data.description && <p class="lede">{entry.data.description}</p>}
    <time datetime={date.toISOString().slice(0, 10)}>
      {date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <Fragment set:html={html} />
  </article>
</Base>
