---
import Base from '../layouts/Base.astro';
import { cms } from '../lib/cms';

// `about.intro` has no content file in this repository: it renders the schema's defaults.
const intro = cms.region('about.intro');
---

<Base title={intro.heading} description={intro.body}>
  <section class="page-intro">
    <h1>{intro.heading}</h1>
    <p class="lede">{intro.body}</p>
  </section>

  <section aria-labelledby="principles">
    <h2 id="principles">What we hold to</h2>
    <dl class="principles">
      <div>
        <dt>Plain files</dt>
        <dd>Words live in the repository beside the code, in formats any tool can read.</dd>
      </div>
      <div>
        <dt>Nothing at runtime</dt>
        <dd>Pages are built ahead of time, so there is no server to slow a visitor down.</dd>
      </div>
      <div>
        <dt>History you can trust</dt>
        <dd>Every change is a commit with an author, and any of them can be undone.</dd>
      </div>
    </dl>
  </section>
</Base>
