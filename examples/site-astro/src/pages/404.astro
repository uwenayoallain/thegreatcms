---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="There is no page at this address.">
  <section>
    <p class="eyebrow">404</p>
    <h1>Nothing lives here</h1>
    <p>
      A missing content file renders schema defaults; a missing page is simply missing.
      Try one of these instead.
    </p>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/about/">About</a></li>
      <li><a href="/blog/">Blog</a></li>
    </ul>
  </section>
</Base>
