---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** A page nobody should land on from a search: the not-found page, a thank-you. */
  noindex?: boolean;
  /** Structured data for the page, as schema.org JSON-LD. */
  schema?: Record<string, unknown>;
}

const { title, description, noindex, schema } = Astro.props;
// Trailing slashes are the address each page is built at, so a click never waits on a redirect.
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
];
// The browser loads a page as the pointer settles on its link; it is data, not a script that runs.
const speculation = JSON.stringify({
  prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
});
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path === '/' ? '/' : `${path}/`, Astro.site).href;
// A post is inside Blog: the link says so, without claiming to be the page itself.
const current = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  return path === target ? 'page' : target !== '/' && path.startsWith(`${target}/`) ? 'true' : undefined;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={schema?.['@type'] === 'BlogPosting' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Example" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', ...schema }).replaceAll('<', '\\u003c')} />}
    <script type="speculationrules" is:inline set:html={speculation} />
  </head>
  <body>
    <!-- A skip link is the cheapest accessibility win there is: it lets keyboard
         and screen reader users jump the navigation on every page. -->
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="wordmark" href="/">Example<span aria-hidden="true">.</span></a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-main">
        <a class="wordmark" href="/">Example<span aria-hidden="true">.</span></a>
        <p>Fast, quiet websites, built from plain files.</p>
      </div>
      <details class="colophon">
        <summary>How this site is built</summary>
        <ul>
          <li>The home page's headline and the cards under "Why it works this way" are edited in GreatCMS.</li>
          <li>The about page has never been edited: its words are the defaults in the schema.</li>
          <li>Blog posts are Markdown files in the repository.</li>
          <li>Everything else is ordinary Astro, and no page ships any JavaScript.</li>
        </ul>
      </details>
      <p class="copyright">© {new Date().getFullYear()} Example</p>
    </footer>
  </body>
</html>
