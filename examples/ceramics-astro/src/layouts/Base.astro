---
import "../styles/site.css";
// The headings' face, fetched with the page rather than discovered in the stylesheet.
import serif from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import { cms } from "../lib/cms";

interface Props {
  title?: string;
  description?: string;
  /** A page nobody should land on from a search. */
  noindex?: boolean;
  /** Structured data for the page, as schema.org JSON-LD. */
  schema?: Record<string, unknown>;
}
const { title, noindex, schema } = Astro.props;
const identity = cms.region("site.identity");
const visit = cms.region("visit");
const pageTitle = title ? `${title} · ${identity.name}` : `${identity.name}: ${identity.tagline ?? "ceramics"}`;
const description = Astro.props.description ?? identity.tagline ?? `${identity.name}: ceramics and clay workshops.`;
const here = Astro.url.pathname;
const canonical = new URL(here, Astro.site).href;
// A studio that has not written its address yet has none to show.
const address = (visit.address ?? "").split("\n").filter(Boolean);
const nav = [
  { href: "/workshops/", label: "Workshops" },
  { href: "/visit/", label: "Visit" },
  { href: "/book/", label: "Book a place" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify({ "@context": "https://schema.org", ...schema }).replaceAll("<", "\\u003c")} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <script type="speculationrules" is:inline>
      {"prerender":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <a class="wordmark" href="/" aria-label={`${identity.name}, home`}>
        <span class="mark" aria-hidden="true">I</span>
        <span class="wordmark__name">{identity.name}</span>
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={here.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="colophon">
      <div>
        <p class="colophon__name">{identity.name}</p>
        {identity.tagline && <p>{identity.tagline}</p>}
      </div>
      {(address.length > 0 || identity.email) && (
        <address>
          {address.map((line) => <span>{line}</span>)}
          {identity.email && <a href={`mailto:${identity.email}`}>{identity.email}</a>}
        </address>
      )}
    </footer>
  </body>
</html>
