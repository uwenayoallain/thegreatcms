---
import Base from "../layouts/Base.astro";
import { cms, formAction, francs, upcoming, when } from "../lib/cms";

const booking = cms.region("booking");
const open = upcoming().filter((workshop) => !workshop.full);
---
<Base title={booking.heading} description={booking.text}>
  <section class="page-head">
    <p class="eyebrow">Workshops</p>
    <h1>{booking.heading}</h1>
    {booking.text && <p class="lede">{booking.text}</p>}
  </section>
  <form class="booking" method="POST" action={formAction("booking")}>
    <input type="hidden" name="_redirect" value="/book/thanks/" />
    <fieldset class="booking__group booking__slots">
      <legend><span class="booking__n">1</span>Choose a workshop</legend>
      {open.map((workshop, index) => {
        const date = when(workshop.date);
        const [weekday, day, month] = date.day.split(" ");
        return (
          <div class="slot">
            <input type="radio" id={`w-${workshop.slug}`} name="workshop" value={workshop.title} checked={index === 0} required />
            <label for={`w-${workshop.slug}`}>
              <span class="slot__date"><span class="slot__day">{day}</span>{month?.slice(0, 3)}</span>
              <span class="slot__what">
                <strong>{workshop.title}</strong>
                <span>{weekday?.replace(",", "")} at {date.time} · {workshop.length} · {workshop.level}</span>
              </span>
              <span class="slot__price">
                <strong>{francs(workshop.price)}</strong>
                <span>Groups of {workshop.seats}</span>
              </span>
            </label>
          </div>
        );
      })}
      <div class="slot slot--any">
        <input type="radio" id="w-next" name="workshop" value="Next available date" />
        <label for="w-next">
          <span class="slot__date" aria-hidden="true">?</span>
          <span class="slot__what">
            <strong>Whichever comes next</strong>
            <span>We will offer you the first date with room.</span>
          </span>
        </label>
      </div>
    </fieldset>
    <fieldset class="booking__group booking__details">
      <legend><span class="booking__n">2</span>Your details</legend>
      <div class="field-row">
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" autocomplete="name" placeholder="Aline Uwase" required />
          <p class="field__error">Tell us whose name to put on the place.</p>
        </div>
        <div class="field">
          <label for="people">How many</label>
          <input id="people" name="people" type="number" min="1" max="12" value="1" inputmode="numeric" required />
          <p class="field__error">Between 1 and 12.</p>
        </div>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby="email-hint" required />
        <p class="field__hint" id="email-hint">We confirm your place by email within a day.</p>
        <p class="field__error">That address is missing an @ or a domain.</p>
      </div>
      <div class="field">
        <label for="message">Anything we should know <span class="optional">(optional)</span></label>
        <textarea id="message" name="message" rows="4" placeholder="Left-handed, coming with a friend, a birthday…"></textarea>
      </div>
      <div class="honeypot" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" tabindex="-1" autocomplete="off" />
      </div>
      <button class="button booking__send" type="submit">{booking.button}</button>
      <p class="booking__note">Prices include materials and firing.</p>
    </fieldset>
  </form>
</Base>
