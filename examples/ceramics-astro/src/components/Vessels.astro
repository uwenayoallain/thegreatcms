---
/** Three thrown pots, drawn rather than photographed: the hero's picture until the studio sets one. */
---
<svg class="vessels" viewBox="0 0 420 320" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="clay" x1="0" x2="1">
      <stop offset="0" stop-color="var(--clay-deep)" />
      <stop offset="0.55" stop-color="var(--clay)" />
      <stop offset="1" stop-color="var(--clay-deep)" />
    </linearGradient>
    <linearGradient id="glaze" x1="0" x2="1">
      <stop offset="0" stop-color="var(--glaze-deep)" />
      <stop offset="0.5" stop-color="var(--glaze)" />
      <stop offset="1" stop-color="var(--glaze-deep)" />
    </linearGradient>
  </defs>
  <ellipse cx="210" cy="300" rx="190" ry="12" fill="var(--shadow)" />
  <path class="pot pot--tall" d="M70 296c-22-40-30-96-12-140 8-20 10-40 4-58h52c-6 18-4 38 4 58 18 44 10 100-12 140z" fill="url(#clay)" />
  <path d="M62 98h52" stroke="var(--ink)" stroke-opacity=".25" stroke-width="3" />
  <path class="pot pot--bowl" d="M150 236c0 36 30 62 70 62s70-26 70-62z" fill="url(#glaze)" />
  <path d="M150 236h140" stroke="var(--ink)" stroke-opacity=".2" stroke-width="3" />
  <path class="pot pot--jar" d="M318 296c-26-8-38-40-34-72 4-30 20-44 24-62h40c4 18 20 32 24 62 4 32-8 64-34 72z" fill="url(#clay)" />
  <rect x="306" y="150" width="44" height="12" rx="6" fill="var(--clay-deep)" />
  <path d="M296 212c20 8 44 8 64 0" stroke="var(--cream)" stroke-opacity=".5" stroke-width="4" fill="none" />
</svg>

<style>
  .vessels { width: 100%; height: auto; display: block; }
  .pot { transform-box: fill-box; transform-origin: 50% 100%; }
  @media (prefers-reduced-motion: no-preference) {
    .pot { animation: rise 900ms cubic-bezier(.2,.8,.2,1) both; }
    .pot--bowl { animation-delay: 120ms; }
    .pot--jar { animation-delay: 240ms; }
  }
  @keyframes rise { from { transform: translateY(12px) scaleY(.94); opacity: 0; } }
</style>
