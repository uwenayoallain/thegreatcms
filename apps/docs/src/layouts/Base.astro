---
import "@fontsource/space-grotesk/latin-400.css";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-grotesk/latin-700.css";
import "../styles/site.css";
import { cms } from "../lib/cms";
import { pixelWord } from "../lib/pixel";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path === "/" ? "/" : `${path}/`, Astro.site).href;
const footer = cms.region("site.footer");
const nav = [
  { href: "/docs/", label: "Docs" },
  { href: "/spec/", label: "Standard" },
  { href: "https://github.com/uwenayoallain/thegreatcms", label: "Source" },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f6f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101113" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GreatCMS" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="llms.txt" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead ink">
      <a class="wordmark" href="/"><svg class="mark" viewBox="0 0 10 10" aria-hidden="true"><rect width="10" height="10" rx="2.2" fill="#0e0f11"/><g shape-rendering="crispEdges"><path fill="#0b5c47" d="M3.25 1.75h5v1h-5zM2.25 2.75h2v1h-2zM2.25 3.75h2v1h-2zM2.25 4.75h2v1h-2zM5.25 4.75h3v1h-3zM2.25 5.75h2v1h-2zM6.25 5.75h2v1h-2zM2.25 6.75h2v1h-2zM6.25 6.75h2v1h-2zM3.25 7.75h5v1h-5z"/><path fill="#f3f3f3" d="M2.75 1.25h5v1h-5zM1.75 2.25h2v1h-2zM1.75 3.25h2v1h-2zM1.75 4.25h2v1h-2zM1.75 5.25h2v1h-2zM5.75 5.25h2v1h-2zM1.75 6.25h2v1h-2zM5.75 6.25h2v1h-2zM2.75 7.25h5v1h-5z"/><path fill="#1fbf8a" d="M4.75 4.25h3v1h-3z"/></g></svg> GreatCMS</a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={path.startsWith(item.href.replace(/\/$/, "")) && item.href.startsWith("/") ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon ink">
      <Fragment set:html={pixelWord("GreatCMS")} />
      <div class="inner">
        <p>{footer.note}</p>
        <ul>
          {(footer.links ?? []).map((link) => (
            <li><a href={link.href}>{link.label ?? link.href}</a></li>
          ))}
        </ul>
        <p>{footer.claim}</p>
      </div>
    </footer>
  </body>
</html>
