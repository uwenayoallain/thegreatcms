---
import regular from "@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url";
import medium from "@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url";
import bold from "@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url";
import "../styles/site.css";
import { cms } from "../lib/cms";
import { pixelWord } from "../lib/pixel";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path === "/" ? "/" : `${path}/`, Astro.site).href;
const footer = cms.region("site.footer");
const nav = [
  { href: "/docs/", label: "Docs" },
  { href: "/spec/", label: "Standard" },
  { href: "https://github.com/uwenayoallain/thegreatcms", label: "Source" },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {[regular, medium, bold].map((font) => <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />)}
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f6f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101113" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GreatCMS" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="llms.txt" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead ink">
      <a class="wordmark" href="/"><img class="mark" src="/favicon.svg" alt="" width="28" height="28" /> GreatCMS</a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={path.startsWith(item.href.replace(/\/$/, "")) && item.href.startsWith("/") ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon ink">
      <Fragment set:html={pixelWord("GreatCMS")} />
      <div class="inner">
        <p>{footer.note}</p>
        <ul>
          {(footer.links ?? []).map((link) => (
            <li><a href={link.href}>{link.label ?? link.href}</a></li>
          ))}
        </ul>
        <p>{footer.claim}</p>
      </div>
    </footer>
  </body>
</html>
