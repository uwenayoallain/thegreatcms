---
import "@fontsource/space-grotesk/latin-400.css";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-grotesk/latin-700.css";
import "../styles/site.css";
import { cms } from "../lib/cms";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path === "/" ? "/" : `${path}/`, Astro.site).href;
const footer = cms.region("site.footer");
const nav = [
  { href: "/docs/", label: "Docs" },
  { href: "/spec/", label: "Standard" },
  { href: "https://github.com/greatcms/greatcms", label: "Source" },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f6f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101113" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GreatCMS" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="llms.txt" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <a class="wordmark" href="/"><svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#15171a"/><path d="M22.9 10.2A9 9 0 1 0 25 16" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round"/><path d="M25 16h-7" stroke="#fff" stroke-width="5" stroke-linecap="round"/><circle cx="17.5" cy="16" r="3.6" fill="#1fbf8a"/></svg> GreatCMS</a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={path.startsWith(item.href.replace(/\/$/, "")) && item.href.startsWith("/") ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="inner">
        <p>{footer.note}</p>
        <ul>
          {(footer.links ?? []).map((link) => (
            <li><a href={link.href}>{link.label ?? link.href}</a></li>
          ))}
        </ul>
        <p>{footer.claim}</p>
      </div>
    </footer>
  </body>
</html>
