---
import DocsNav from "../components/DocsNav.astro";
import OnThisPage from "../components/OnThisPage.astro";
import Base from "../layouts/Base.astro";
import { renderMarkdown } from "../lib/markdown";
import { readRepoFile } from "../lib/repo";

// Rendered from the repository's SPEC.md, so the published standard and the one the code implements cannot drift.
const source = readRepoFile("SPEC.md");
const { html, headings } = await renderMarkdown(source.replace(/^# .*\n/, ""));
---

<Base
  title="The GreatCMS Content Standard"
  description="The file format a site must contain to be managed: schema, content layout, and resolution rules."
>
  <div class="docs">
    <DocsNav current="__spec" />

    <article class="prose">
      <p class="stamp">Standard · version 1</p>
      <h1>The content standard</h1>
      <p class="summary">
        This document is the product; everything else in the repository implements it. Reading it
        should be enough to write a consumer in any language in under half an hour.
      </p>
      <OnThisPage headings={headings} />
      <Fragment set:html={html} />
      <p class="source-note">
        <a href="/spec.md">This document as Markdown</a> · <a href="/json-schema/schema.schema.json"
          >JSON Schema for schema.yaml</a
        > · <a href="/json-schema/config.schema.json">JSON Schema for config.yaml</a>
      </p>
    </article>
  </div>
</Base>
