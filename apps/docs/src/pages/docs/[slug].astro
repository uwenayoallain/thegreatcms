---
import { marked } from "marked";
import DocsNav from "../../components/DocsNav.astro";
import Base from "../../layouts/Base.astro";
import { docsPages } from "../../lib/cms";

export function getStaticPaths() {
  return docsPages().map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const html = marked.parse(page.body) as string;
---

<Base title={`${page.title} — GreatCMS`} description={page.summary}>
  <div class="docs">
    <DocsNav current={page.slug} />

    <article class="prose">
      <p class="stamp">Documentation</p>
      <h1>{page.title}</h1>
      {page.summary && <p class="summary">{page.summary}</p>}
      <Fragment set:html={html} />
    </article>
  </div>
</Base>
