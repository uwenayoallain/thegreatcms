# The previews: each site's dev server under its own name, shown only to someone signed in to
# the studio. cloudflared brings every preview name here over plain HTTP; TLS ends at Cloudflare.

{
	auto_https off
	admin off
}

# The studio answers 204 for a signed-in browser and sends anyone else to sign in.
(gate) {
	forward_auth studio:8787 {
		uri /auth/check
		header_up X-Forwarded-Proto https
	}
}

http://paraline-preview.{$PREVIEW_DOMAIN} {
	import gate
	reverse_proxy previews:4322
}

http://example-preview.{$PREVIEW_DOMAIN} {
	import gate
	reverse_proxy previews:4323
}

http://bakery-preview.{$PREVIEW_DOMAIN} {
	import gate
	reverse_proxy previews:4324
}

http://journal-preview.{$PREVIEW_DOMAIN} {
	import gate
	reverse_proxy previews:4325
}

http://sundial-preview.{$PREVIEW_DOMAIN} {
	import gate
	reverse_proxy previews:4326
}

http://docs-preview.{$PREVIEW_DOMAIN} {
	import gate
	reverse_proxy previews:4327
}

http://ibumba-preview.{$PREVIEW_DOMAIN} {
	import gate
	reverse_proxy previews:4328
}

# The public website: whatever release the builder last swapped live, open to everyone.
http://{$WEBSITE_HOST} {
	root * /srv/www/current
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	# Astro fingerprints these, so a changed file always has a new name.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
