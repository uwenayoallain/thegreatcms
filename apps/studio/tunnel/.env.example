# Copy to .env. Everything the studio and its tunnel need; nothing here is committed.

# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel (cloudflared), then copy its token.
CLOUDFLARE_TUNNEL_TOKEN=
# The public hostname the tunnel routes to http://studio:8787.
STUDIO_HOST=studio.example.com

# What editors type to sign in. Long, because this address is on the internet.
STUDIO_PASSWORD=
# Signs the session cookies, so signing in survives a restart:  openssl rand -hex 32
STUDIO_SECRET=

# The folder holding the sites, mounted at the same path inside the container.
SITES_DIR=/srv/sites
# The parent domain of the previews: site "my-site" previews at my-site-preview.example.com, and
# signing in to the studio opens it. Add each name to the tunnel, pointing at http://caddy:80.
PREVIEW_DOMAIN=example.com
# The sites to manage, by their path under SITES_DIR. devUrl is where browsers see the preview;
# probeUrl is where the studio checks that its dev server is running (in the previews container).
STUDIO_SITES=[{"id":"my-site","name":"My site","path":"/srv/sites/my-site","devUrl":"https://my-site-preview.example.com","probeUrl":"http://previews:4322"}]

# Commits made from the studio carry this name.
GIT_NAME=Studio
GIT_EMAIL=studio@example.com

# Optional: email every contact-form submission.
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=
