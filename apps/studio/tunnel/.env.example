# Copy to .env. Everything the studio and its tunnel need; nothing here is committed.

# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel (cloudflared), then copy its token.
CLOUDFLARE_TUNNEL_TOKEN=
# The public hostname the tunnel routes to http://studio:8787.
STUDIO_HOST=studio.example.com

# What editors type to sign in. Long, because this address is on the internet.
STUDIO_PASSWORD=
# Signs the session cookies, so signing in survives a restart:  openssl rand -hex 32
STUDIO_SECRET=

# The folder holding the sites, mounted at the same path inside the containers. The connect page
# lists the sites in it, and "Copy from Git" clones into it.
SITES_DIR=/srv/sites
# Optional: a different folder for that list and for clones, when SITES_DIR is something else.
SITES_ROOT=
# The parent domain of the previews: a site connected in the studio previews at
# <site>-preview.example.com, and signing in to the studio opens it. Give the tunnel one wildcard
# public hostname, *.example.com -> http://caddy:80, after the studio's.
PREVIEW_DOMAIN=example.com
# Optional: sites to manage from the start, under ids that never change. Most sites are connected
# from the studio instead. A devUrl of https://<name>-preview.PREVIEW_DOMAIN is run by the previews.
STUDIO_SITES=[{"id":"my-site","name":"My site","path":"/srv/sites/my-site","devUrl":"https://my-site-preview.example.com"}]

# The public website the `website` service builds from every commit in SITES_DIR (by default
# greatcms.PREVIEW_DOMAIN). Add it to the tunnel, pointing at http://caddy:80, and give the site
# "deployRoot":"/srv/www" in STUDIO_SITES so the studio shows what is live.
WEBSITE_HOST=
WEBSITE_BRANCH=main

# Optional limits; the values here are the defaults. PREVIEW_MAX_RUNNING is how many dev servers
# run at once (one more stops the longest unused), PREVIEW_IDLE the quiet seconds before one stops.
# PREVIEW_UID and PREVIEW_GID are the owner of SITES_DIR on the host, when that is not 1000.
#PREVIEW_MAX_RUNNING=6
#PREVIEW_IDLE=900
#PREVIEW_MEMORY=3g
#WEBSITE_MEMORY=2g
#STUDIO_MEMORY=1g
#PREVIEW_UID=1000
#PREVIEW_GID=1000

# Commits made from the studio carry this name.
GIT_NAME=Studio
GIT_EMAIL=studio@example.com

# Optional: email every contact-form submission.
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=

# Optional: GitHub logins that are owners of this studio when they sign in with GitHub, besides
# the account that owns the studio's GitHub App. Comma-separated.
#STUDIO_GITHUB_OWNERS=
