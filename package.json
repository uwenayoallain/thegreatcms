{
  "name": "thegreatcms",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "node scripts/dev.mjs",
    "studio": "pnpm --filter @greatcms/studio dev",
    "greatcms": "node packages/cli/bin/greatcms.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check . && node scripts/gen-agent-docs.mjs --check && turbo run typecheck test",
    "docs:check": "node scripts/gen-agent-docs.mjs --check",
    "docs:build": "node scripts/gen-agent-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.21.0"
}
